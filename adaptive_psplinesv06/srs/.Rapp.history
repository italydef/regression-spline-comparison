x<-dff1$x
yy<-dff1$yy
y<-dff1$y
range(x)
y.fit <- asp2(yy~f(x,adap=TRUE))
y.fit <- asp2(yy~f(x,adap=FALSE))
kn1 <- default.knots(x,20)
fit= asp2(yy~f(x,basis="os",degree=3,knots=kn1,adap=FALSE),#
  								niter = 20, niter.var = 200)
plot(fit,residuals=TRUE,shade=TRUE,scb.lty="blank")
plot(x,yy,pch=20,col="grey")
lines(x,y)
lines(x,fit$fitted,col="blue")
