heavisinewang<-function(n){#
  x<-seq(0,1,length=n)#
  true<-2*sin(4*pi*x)-6*abs(x-0.4)^(3/10)-sign(0.7-x)#
  return(list(true=true,x=x))#
}
n<-256#
 au<- heavisinewang(n) # heavisine Wang#
 y<-au$true#
 x<-au$x#
 SNR=3#
