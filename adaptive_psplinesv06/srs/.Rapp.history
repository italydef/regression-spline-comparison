#### =========  SIMULATIOS ================== #####
#### Handling the methods to be used#
suppressWarnings(source("~/Desktop/work/AMPS/METHODS.R"))#
#
# Perfect! Let’s make a ready-to-use R snippet for your simulation study. This will:#
# Handle 6 functions (f1–f6) and 16 methods#
# Apply them to 50 simulation datasets (numeric vectors)#
# Compute two criteria per dataset (RMSE and MXDV)#
# Return a tidy data frame ready for heatmaps, ranking, or ComplexHeatmap.#
# sign function#
sign<-function(x){#
  s <- 2*(x>0)-1#
  return(s)#
}#
#
varcalib<-function(y,sigmc,m){#
    d<-diff(y)#
    estsig<-0#
    n<-length(d)#
    dvd<-rep(0,n)#
    thresh<-rep(0,m)#
    ds<-sort(abs(d))#
    for(i in (1:m)){#
    dstar<-diff(y+sigmc*rnorm(n+1))#
    dstars<-sort(abs(dstar))#
    for (c in (1:n)) dvd[c] <- (sum(dstars[1:c]^2) - sum(ds[1:c]^2))/(2*c)-sigmc^2#
    thresh[i]<-which.max(dvd*(dvd<0))#
    }#
    cthresh<-mean(thresh)#
    estsig<- sum(ds[1:cthresh]^2)/(2*c)#
    return(list(c=cthresh,sigma=sqrt(estsig),dvd=dvd))#
}#
# 1️⃣ Example Setup#
#
n_functs=6  # Number of test functions#
n_methods=16 # Number of methods#
n_sim <- 50 # Number of simulations runs#
n_points <- 256 # number of design points#
bdeg<-2#
#
# Methods applied#
# METHODS<-c("RC","BASP","DMS","BARS","TF", "EASP","HAS", "EAS", "MRS", "GeDS","CPR","SARS","ASPl","FREEK","AMP","SCHA")#
METHODS<-c("RC","BASP","DMS","BARS","TF", "EASP","HAS", "EAS", "FAPS", "GeDS","CPR","SARS","ASPl","FREEK","AMP","SCHA")#
methods <- METHODS#
rmse3d<-array(rep(0, n_functs*n_methods*n_sim), dim=c(n_functs, n_methods, n_sim))#
mxdv3d<-array(rep(0, n_functs*n_methods*n_sim), dim=c(n_functs, n_methods, n_sim))#
# Define 6 test functions #
#
f1 <- function(x) ifelse(x < 0.5, -1.5, 0.25 * sin(x ^ 2 * pi ^ 1.5))#
f2 <- function(x) ifelse(x < 0.6, 1 / (0.01 + (x - 0.3) ** 2), 1 / (0.015 + (x - 0.65) **2))#
f3 <- function(x) 100 / (exp(abs(10 * x - 5))) + ((10 * x - 5) ^ 5) / 500#
f4 <- function(x) {#
  y <- sin(15 * x) + 0.3 * x ^ 2#
  jump1 <- 0.4#
  jump2 <- 0.6#
  jump3 <- 0.8#
  y[x < jump1] <- y[x < jump1] + 2#
  y[x >= jump1 & x < jump2] <- y[x >= jump1 & x < jump2] - 2#
  y[x >= jump2 & x < jump3] <- y[x >= jump2 & x < jump3] + 1#
  return(y)#
}#
f5 <- function(x) sin(5.5*pi*x) - 4*sign(x[59]-x) - 2*sign(x[78]-x) +3*sign(x[180]-x)-1.75#
f6 <- function(x) 2*sin(4*pi*x)-6*abs(x-0.4)^(3/10)-sign(0.7-x)#
#
test_funcs <- paste0("f", 1:n_functs)#
# ydat<-matrix(0,nrow=n_sim,ncol=n_points)#
# 2️⃣ Function to Compute Criteria#
#  RMSE and MXDV are defined as:#
#
compute_criteria <- function(pred, true) {#
  rmse <- sqrt(mean((pred - true)^2))#
  mxdv <- max(abs(pred - true))#
  c(RMSE = rmse, MXDV = mxdv)#
}#
#
# pred = output of method#
# true = vector of “true values” (e.g., your test function outputs)#
### Calling Matlab server #
setwd('~/Desktop/work/AMPS/adaptive_psplinesv06/srs')#
library(R.matlab)#
Matlab$startServer()#
matlab <- Matlab()#
isOpen <- open(matlab)#
if (isOpen==TRUE) print("Matlab server is open")#
#
#  3️⃣ Generate Simulations and Apply Methods#
#
results_list <- list()#
#
counter <- 1#
index_fun<-0#
#
set.seed(123)#
#
for(f_name in test_funcs) {#
  cat("test function = ", f_name, "\n")#
  index_fun<-index_fun+1#
  f_fun <- get(f_name)  # get test function#
  x <- seq(0,1,length=n_points)  # replace with your sim generator#
  t<-x#
  knots1<-default.knots(t,12)#
  SNR=3#
  y_true <- f_fun(x)#
  sig<-sqrt(var(y_true))/SNR#
  kn<- default.knots(x,n_points/4) #
  kn.var<- default.knots(kn,30)#
  for(sim_id in 1:n_sim) {#
    # Generate simulation input (numeric vector)#
      cat("simulation run = ", sim_id, "\n")#
      yy<-as.vector(y_true+rnorm(n_points,mean=0,sd=sig))#
      if (sim_id==1)  assign(paste0("df", f_name), data.frame(x=x,yy=yy,y=y_true))#
      index_meth<-0#
      for(m_name in methods) {#
       cat('Method =', m_name,"\n")#
       index_meth<-index_meth+1#
       m_fun <- get(m_name)  # get method function#
      # y_pred <- m_fun(y_true)  # apply method to dataset#
      y_pred <- m_fun(yy,x)#
      crit <- compute_criteria(y_pred, y_true)#
      results_list[[counter]] <- data.frame(#
        test_function = f_name,#
        sim_id       = sim_id,#
        method       = m_name,#
        RMSE         = crit["RMSE"],#
        MXDV         = crit["MXDV"]#
      )#
      rmse3d[index_fun,index_meth,sim_id]=crit["RMSE"]#
      mxdv3d[index_fun,index_meth,sim_id]=crit["MXDV"]#
      counter <- counter + 1#
    }#
  }#
}#
close(matlab)#
#
setwd("~/Desktop/work/AMPS") # where we store the results#
#
