library(dplyr)#
library(ggplot2)#
library(mgcv)#
library(purrr)#
library(tibble)#
#
# Test functions #
f1 <- function(x) {#
  y <- ifelse(x < 0.5, -1.5, 0.25 * sin(x ^ 2 * pi ^ 1.5))#
  return(y)#
}#
#
f2 <- function(x) {#
  y <-#
    ifelse(x < 0.6, 1 / (0.01 + (x - 0.3) ** 2), 1 / (0.015 + (x - 0.65) **#
                                                        2))#
  return(y)#
}#
#
f3 <- function(x) {#
  y <- 100 / (exp(abs(10 * x - 5))) + ((10 * x - 5) ^ 5) / 500#
  return(y)#
}#
#
f4 <- function(x) {#
  y <- sin(15 * x) + 0.3 * x ^ 2#
  jump1 <- 0.4#
  jump2 <- 0.6#
  jump3 <- 0.8#
  y[x < jump1] <- y[x < jump1] + 2#
  y[x >= jump1 & x < jump2] <- y[x >= jump1 & x < jump2] - 2#
  y[x >= jump2 & x < jump3] <- y[x >= jump2 & x < jump3] + 1#
  return(y)#
}#
f5 <- function(x) {#
  result <- 90 / (1 + exp(-100 * (x - 0.4)))#
  return(result)#
}#
f6 <- function(x) {#
  result <- 2*sin(4*pi*x)-6*abs(x-0.4)^(3/10)-sign(0.7-x)#
  return(result)#
}#
n<-200#
x<-seq(0,1, length=n)#
SNR=3#
#
 sig<-sqrt(var(y))/SNR#
 bdeg<-2#
simulate_data <- function(func, x, SNR) {#
  f <- func(x) #
  sig<- sqrt(var(f))/SNR#
  noise<- rnorm(length(x), mean = 0, sd = sigma)#
  y<-f+noise#
  data <- data.frame(x=x, y=y, f=f)#
  return(data)#
}#
set.seed(101)#
#
data1<-simulate_data(f1,x,SNR)#
 p <- ggplot() +#
    geom_point(#
      data = data1,#
      aes(x = x, y = y),#
      shape = 16,#
      size = 1,#
      col = rgb(0, 0, 1, alpha = 0.4)#
    ) +#
    geom_line(#
      data = data1,#
      aes(x = x, y = f),#
      color = "black",#
      size = 1.5#
    ) + #
    labs(x = "x", y = "Spline Value") +#
    theme_minimal()#
  print(p)
