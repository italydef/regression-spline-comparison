    if (length(peaks_found) == 0) clp[i]=0#
    if (length(peaks_found) > 0) clp[i]=1#
    lines(datas[datas$id==i,2],pSignal, type="l", col=clp[i]+1, pch=20,lwd=1.2)#
 }#
#
auxsig1<-NULL#
auxsig2<-NULL#
for (i in (1:75)) {#
 if (clp[i]==0) auxsig1<-rbind(auxsig1,datas[datas$id==i,3])#
 if (clp[i]==1) auxsig2<-rbind(auxsig2,datas[datas$id==i,3])#
 }#
mean1<-apply(auxsig1,2,mean)#
mean2<-apply(auxsig2,2,mean)#
points(datas[datas$id==i,2], mean1, col=1, pch=20, cex=2)#
points(datas[datas$id==i,2], mean2, col=2, pch=20, cex=2)#
#
plot(diff(mean1),type="l", col=1, main="moyennes sur données lissées Delta Vt sans et avec OS")#
lines(diff(mean2),type="l", col=2)
caret::confusionMatrix(as.factor(mod$clus$classes), as.factor(clp+1))
