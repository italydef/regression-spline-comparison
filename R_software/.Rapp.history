library(genlasso)#
library(splines)#
library(AdaptFit)#
library(AdaptFitOS)#
require(stats)#
require(graphics)#
library(EbayesThresh)#
library(wavethresh)#
library(Rwave)#
setwd("~/Desktop/work/AMPS/R_software")#
source("mybases.r")#
# source("/Users/anestisa/Desktop/new/newfiles/Marx/CourseSoftware/Software/R_software/mypnormal.r")#
source("mypnormalb.r")#
heavisine <- ts(scan("heavisine.txt"))#
varcalib<-function(y,sigmc,m){#
    d<-diff(y)#
    estsig<-0#
    n<-length(d)#
    dvd<-rep(0,n)#
    thresh<-rep(0,m)#
    ds<-sort(abs(d))#
    for(i in (1:m)){#
    dstar<-diff(y+sigmc*rnorm(n+1))#
    dstars<-sort(abs(dstar))#
    for (c in (1:n)) dvd[c] <- (sum(dstars[1:c]^2) - sum(ds[1:c]^2))/(2*c)-sigmc^2#
    thresh[i]<-which.max(dvd*(dvd<0))#
    }#
    cthresh<-mean(thresh)#
    estsig<- sum(ds[1:cthresh]^2)/(2*c)#
    return(list(c=cthresh,sigma=sqrt(estsig),dvd=dvd))#
}#
# y<-example.1()$y#
yy<- heavisine#
n<-length(yy)#
x<-seq(0,1,length.out=n)#
SNR<-3#
sig<-sqrt(var(yy))/SNR#
set.seed(8)#
error=rnorm(n,mean=0,sig)#
y<-yy+error#
ydwt<-wd(y)#
nlevs<-log(length(y),2)-1#
vscale <- mad(accessD(ydwt, level = nlevs))#
estsig<-varcalib(diff(y),vscale,30)$sigma#
sd<-estsig#
plot(x,y,cex=0.8,col="grey", main="Heavisine data",pch=20)#
lines(x,yy,col="black", lwd=2)
library(ggplot2)
library(segmented)
lm_fit <- lm(y ~ x)#
#
# Use segmented to estimate change-point#
seg_fit <- segmented(lm_fit, seg.Z = ~x, psi = list(x = c(0.25,0.75)))
reakpoint <- seg_fit$psi[c(1,2)]
breakpoint <- seg_fit$psi[c(1,2)]
breakpoint
cat("Estimated discontinuity at x =", round(breakpoint, 3), "\n")
x_grid <- seq(0, 1, length.out = 200)#
y_pred <- predict(seg_fit, newdata = data.frame(x = x_grid))
lines(x_grid, y_pred, col = "red", lwd = 2)#
abline(v = breakpoint, col = "darkgreen", lty = 3)
library(earth)#
#
# Fit MARS model#
mars_fit <- earth(y ~ x)#
#
# Summary shows knot (hinge) locations#
summary(mars_fit)#
#
# Predict on a grid#
x_grid <- seq(0, 1, length.out = 200)#
y_mars <- predict(mars_fit, newdata = data.frame(x = x_grid))#
#
# Plot#
lines(x_grid, y_mars, col = "blue", lwd = 2)
rm(list = ls())#
