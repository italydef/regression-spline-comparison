require(sars)#
require(gplsim)#
require(ggplot2)#
require(reshape2)#
require(stargazer)#
#
myplot_si<-function (x, family = gaussian(), ylab = "mean", yscale = NULL, #
    plot_data = FALSE) #
{#
    if (is.null(x$Znames)) {#
        offset_fit <- family$linkinv((x$linear.predictors))#
    }#
    else {#
        offset_fit <- family$linkinv((x$linear.predictors - x$gamma %*% #
            t(x$model$z)))#
    }#
    UQ = cbind(x$model$a, matrix(offset_fit, ncol = 1))#
    if (is.null(yscale)) {#
        ylim = range(offset_fit)#
    }#
    else {#
        ylim = yscale#
    }#
    plot(UQ[order(UQ[, 1]), ], col = "blue", type = "l", ylim = ylim, #
        lty = 1, xlab = "estimated single index", ylab = ylab,lwd=1.2, main="fitted link function")#
    if (plot_data) {#
        graphics::points(UQ[order(UQ[, 1]), 1], (x$model$y)[order(UQ[, #
            1])], pch = 20,col="grey")#
    }#
}#
MakeSignal<-function(signalname="Corner",z){#
  t<-(z-min(z))/diff(range(z))#
  if (signalname=="Step") sig <- 0.2 + 0.6* (t > 1/3 & t <= 0.75)#
  if (signalname=="Wave") sig <- 0.5 + (0.2*cos(4*pi*t)) + (0.1*cos(24*pi*t))#
  if (signalname=="HardSine") sig <- 0.5 + 0.6*sin(2*t) * sin(2*pi*(2*t-1)^2+1)#
  if (signalname=="Blip") sig <- (0.32 + (0.6*t) + 0.3*exp(-100*((t-0.3)^2)))*(t <= 0.8) +  (-0.28 + (0.6*t) + 0.3*exp(-100*((t-1.3)^2)))*(t > 0.8)#
  if (signalname=="HeaviSine") {#
         sig <- 4*sin(4*pi*t) - sign(t - .3) - sign(.72 - t) + 5#
         sig <- (0.6/9)*sig + 0.2#
         }#
  if (signalname=="Angles") sig <- ((2*t + 0.5)*(t <= 0.15)) + #
          ((-12*(t-0.15) + 0.8)*(t > 0.15 & t <= 0.2)) + #
          0.2*(t > 0.2 & t <= 0.5) + #
          ((6*(t - 0.5) + 0.2)*(t > 0.5 & t <= 0.6)) + #
          ((-10*(t - 0.6) + 0.8)*(t > 0.6 & t <= 0.65)) + #
          ((-0.5*(t - 0.65) + 0.3)*(t > 0.65 & t <= 0.85)) + #
          ((2*(t - 0.85) + 0.2)*(t > 0.85))#
  if (signalname=="Corner") {#
      sig <- t#
      sig[t <= 0.5] <- 62.387*10*t[t <= 0.5]^3*(1-4*t[t <= 0.5]^2);#
      sig[0.5 < t & t <= 0.8] <- 62.387*3*(0.125-t[0.5 < t & t <= 0.8]^3)*t[0.5 < t & t <= 0.8]^4;#
          sig[t > 0.8] <- 62.387*59.443*(t[t > 0.8]-1)^3;#
          sig <- (0.6/(range(sig)[2]-range(sig)[1]))*sig+0.6;#
  }#
  return(sig)#
}#
#
ramse<-function(x) sqrt(mean(x^2))#
#
par_out<-paste0("~/Desktop/","extra_results_", sep="","Corner")#
if (!dir.exists(par_out)) {#
   dir.create(par_out, recursive = TRUE)#
}#
set.seed(123)#
n=150#
p=3#
niter=100#
#
X = matrix(stats::runif(p*n), ncol=p)#
A=solve(t(X)%*%X)#
u=runif(n, min = 2.5, max = 5.5)#
true.theta=A%*%t(X)%*%u#
a0 =  true.theta/sqrt(sum(true.theta^2))#
z = X%*%a0#
f=MakeSignal("Corner",z)#
sigma = sqrt(var(f))/SNR#
q = as.vector(f)#
y=q + rnorm(length(q),0,sigma)#
a0#
Z<-NULL  # no partial part#
gplsim_est <- gplsim(y,X,Z,family = gaussian, k=30)#
glpsim_index <- sort(gplsim_est$model$a,index.return=TRUE)#
#
zz<-X%*% gplsim_est$theta; auxz<-sort(zz,index.return=TRUE)#
fhat<-sars(zz,y)
set.seed(123)#
n=150#
p=3#
niter=100#
SNR=4#
#
X = matrix(stats::runif(p*n), ncol=p)#
A=solve(t(X)%*%X)#
u=runif(n, min = 2.5, max = 5.5)#
true.theta=A%*%t(X)%*%u#
a0 =  true.theta/sqrt(sum(true.theta^2))#
z = X%*%a0#
f=MakeSignal("Corner",z)#
sigma = sqrt(var(f))/SNR#
q = as.vector(f)#
y=q + rnorm(length(q),0,sigma)#
a0#
Z<-NULL  # no partial part#
gplsim_est <- gplsim(y,X,Z,family = gaussian, k=30)#
glpsim_index <- sort(gplsim_est$model$a,index.return=TRUE)#
#
zz<-X%*% gplsim_est$theta; auxz<-sort(zz,index.return=TRUE)#
fhat<-sars(zz,y)
q()
