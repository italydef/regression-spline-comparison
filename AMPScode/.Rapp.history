q <- 0.05     # FDR rate#
nsim <- 10    # number of MC trials in VC#
svect <- c(1) # Indicator for shrinkage vector estimator#
initsig <- msigma[model] # true variance
fit <- AMPS(x, y, nknots, q, nsim, svect, initsig)
