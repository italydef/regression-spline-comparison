suppressPackageStartupMessages({#
library(ggpubr)#
library(knitr)#
library(mosaic)#
library(mgcv)#
library(gratia)#
library(ggplot2)#
library(curvclust)#
library(funHDDC)#
library(clValid)#
library(caret)#
library(mclust)#
library(NbClust)#
library(MASS)#
library(fda)#
library(parallel)#
library(pbmcapply)#
library(matrixcalc)#
library(pbapply)#
library(fda.usc)#
library(readxl)#
library(tidyverse)#
library(tidyfun)#
library(mgcv)#
library(pbmcapply)#
library(factoextra)#
library(gridExtra)#
library(cowplot)#
library(sasfunclust)#
})#
#
load("datb.RData")#
str(datb)#
 ##### spaghetti plot of the data#
datas<-datb#
ymin<-min(datas$y); ymax<-max(datas$y)#
plot(datas[datas$id==1,2],datas[datas$id==1,3],col=as.integer(datas[,4]+2)[datas$id==1],type="l",#
    ylim=c(ymin-20,ymax+20), xlab="Time",ylab="Vt",main="spaghetti plot")#
for(i in (1:75)) {#
lines(datas[datas$id==i,2],datas[datas$id==i,3],col=as.integer(datas[,4]+2)[datas$id==i],lwd=2)#
points(datas[datas$id==i,2],datas[datas$id==i,3],col=as.integer(datas[,4]+2)[datas$id==i],pch=20,cex=2)#
}  #
legend(x = "topright", box.col = "brown",#
           bg ="yellow", box.lwd = 2 , title="Gold status", #
            legend=c("Gold I_II", "Gold III_IV"), #
            fill = c("red","green"))#
rm(datas)#
load("smoothdon.RData")#
str(datas)#
datas$id<-as.integer(datas$subject)#
#
##### spaghetti plot of the smoothed data#
#
mapping <- c("I_II" = 0, "III_IV" = 1)#
datas$class<-mapping[datas$group]#
#
##### spaghetti plot of the data#
quartz()#
 ymin<-min(datas$y); ymax<-max(datas$y)#
plot(datas[datas$id==1,2],datas[datas$id==1,3],col=datas[datas$id==1,6]+2,type="l",#
       ylim=c(ymin-20,ymax+20), xlab="Time",ylab="Smooth interpolation Vt",main="spaghetti plot")#
for(i in (1:75)) {#
  lines(datas[datas$id==i,2],datas[datas$id==i,3],col=datas[datas$id==i,6]+2,lwd=1.2)#
 }  #
legend(x = "topright", box.col = "brown",#
            bg ="yellow", box.lwd = 2 , title="Gold status", #
            legend=c("Gold I_II", "Gold III_IV"), #
            fill = c("red","green"))
grid <- seq(0, 1, length.out = 150)#
X<-matrix(0,nrow=75,ncol=150)#
for (i in (1:75)) X[i,]=datas[datas$subject==as.character(i),3]#
domain <- c(0, 1)#
X_basis <- fda::create.bspline.basis(domain, norder = 4, nbasis = 20)#
data <- list(X = t(X), grid = grid)#
data <- list(X = t(X), grid = grid)#
dim(data$X)#
# X_basis<- create.bspline.basis(c(0,1), nbasis=200)#
loglam         = seq(-10, -4, 0.25)#
Gcvsave        = numeric()#
for(i in 1:length(loglam)){#
  fdPari  = fdPar(X_basis, Lfdobj=2, 10^loglam[i])#
  Sm.i    = smooth.basis(data$grid, data$X, fdPari)#
  Gcvsave[i] = sum(Sm.i$gcv)  #
}#
lambda_s=10^loglam[which.min(Gcvsave)]#
fdPari  = fdPar(X_basis, Lfdobj=2,lambda_s)#
data$X_fd<-smooth.basis(data$grid, data$X, fdPari)$fd#
quartz() # checking this is the smoothed data displayed before#
plot(data$X_fd) #
clus_true<-rep("1",75)#
for (i in (1:75)) clus_true[i]=datas[datas$subject==as.character(i),4][1]#
clus_true<-as.factor(clus_true)#
levels(clus_true)<-c(1,2)#
clus_true<-as.integer(clus_true)#
mod<-sasfclust(X=data$X,grid=data$grid,G=2,#
lambda_l = 1,lambda_s =0.001,maxit = 20,q=20)#
print(mod$clus$classes)#
plot(mod)#
#
aux<-NULL#
for (i in (1:75))  aux=c(aux,rep(mod$clus$classes[i],150))#
datas$clust<-aux#
#
# spaghetti plot of the clusters#
quartz()#
 ymin<-min(datas$y); ymax<-max(datas$y)#
plot(datas[datas$id==1,2],datas[datas$id==1,3],col=datas[datas$id==1,7]+2,type="l",#
       ylim=c(ymin-20,ymax+20), xlab="Time",ylab="Smooth interpolation Vt",main="CLustering")#
for(i in (1:75)) {#
  lines(datas[datas$id==i,2],datas[datas$id==i,3],col=datas[datas$id==i,7]+2,lwd=1.2)#
 }  #
legend(x = "topright", box.col = "brown",#
            bg ="yellow", box.lwd = 2 , title="clusters", #
            legend=c("cluster 1", "cluster 2"), #
            fill = c("red","green"))
quartz()#
 ymin<-min(datas$y); ymax<-max(datas$y)#
plot(datas[datas$id==1,2],datas[datas$id==1,3],col=datas[datas$id==1,7]+2,type="l",#
       ylim=c(ymin-20,ymax+20), xlab="Time",ylab="Smooth interpolation Vt",main="Clustering")#
for(i in (1:75)) {#
  lines(datas[datas$id==i,2],datas[datas$id==i,3],col=datas[datas$id==i,7]+2,lwd=1.2)#
 }  #
legend(x = "topright", box.col = "brown",#
            bg ="yellow", box.lwd = 2 , title="clusters", #
            legend=c("cluster 1", "cluster 2"), #
            fill = c("red","green"))
q()
