true <- numeric(n)#
y <- numeric(n)#
x <- numeric(n)#
#
# Simulate function (assumes `simfunct` is defined elsewhere)#
#
sim_data <- simfunct(n, model)#
x <- sim_data$x#
true <- sim_data$true#
#
msigma <- c(0.12, 0.0296, 1.0890, 0.3112,#
            1.0, 1.0, 1.0, 1.0,#
            6.0, 0.3, 0.5,1.8)#
e <- rnorm(n, mean = 0, sd = msigma[model])#
y <- true + e#
#
