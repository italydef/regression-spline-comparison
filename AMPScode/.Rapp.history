#
lambda_s_seq=10^seq(-4,-3) #
lambda_l_seq=10^seq(0,3)#
G_seq=4
mod_cv<-sasfclust_cv(X=data$X,grid=data$grid,G_seq=G_seq,#
lambda_l_seq = lambda_l_seq,lambda_s_seq =lambda_s_seq,maxit = 20,K_fold = 3,q=20,ncores = 1)
plot(mod_cv)
mod<-sasfclust(X=data$X,grid=data$grid,G=mod_cv$G_opt,#
lambda_l = mod_cv$lambda_l_opt,lambda_s =mod_cv$lambda_s_opt,maxit = 20,q=20)#
print(mod$clus$classes)
